---
import DashboardLayout from '../layouts/DashboardLayout.astro';
---
<DashboardLayout title="Productos" currentPage="products">

  <!-- Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold tracking-tight">Catálogo</h1>
      <p class="text-sm text-zinc-500 dark:text-zinc-400 mt-1">Explora y gestiona todos los productos</p>
    </div>
    <div class="flex items-center gap-2">
      <div id="adminActions" style="display:none">
        <button id="newProductBtn" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 transition-colors shadow-sm shadow-indigo-600/20">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
          Nuevo
        </button>
      </div>
      <a href="/login" id="loginLink" style="display:none" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-sm font-medium hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">Iniciar sesión</a>
    </div>
  </div>

  <!-- Filters -->
  <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 p-4 mb-6 flex flex-col md:flex-row gap-3">
    <div class="flex-1 relative">
      <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
      <input id="searchInput" type="text" placeholder="Buscar productos..."
        class="w-full pl-10 pr-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-sm text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition-all" />
    </div>
    <div class="flex gap-3">
      <select id="sortSelect" class="px-4 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 text-sm text-zinc-900 dark:text-zinc-100 outline-none focus:ring-2 focus:ring-indigo-500/40 min-w-[160px]">
        <option value="created_at">Más recientes</option>
        <option value="price_asc">Precio: menor</option>
        <option value="price_desc">Precio: mayor</option>
        <option value="name">Nombre A-Z</option>
      </select>
      <button id="searchBtn" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 transition-colors">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
        Buscar
      </button>
    </div>
  </div>

  <!-- Loading skeleton -->
  <div id="loadingState" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 p-6">
      <div class="flex justify-between mb-4"><div class="skeleton h-12 w-12 rounded-xl"></div><div class="skeleton h-6 w-16 rounded-full"></div></div>
      <div class="skeleton h-5 w-3/4 mb-2"></div><div class="skeleton h-4 w-full mb-4"></div>
      <div class="skeleton h-8 w-20 mt-4"></div>
    </div>
    <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 p-6">
      <div class="flex justify-between mb-4"><div class="skeleton h-12 w-12 rounded-xl"></div><div class="skeleton h-6 w-16 rounded-full"></div></div>
      <div class="skeleton h-5 w-2/3 mb-2"></div><div class="skeleton h-4 w-full mb-4"></div>
      <div class="skeleton h-8 w-24 mt-4"></div>
    </div>
    <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 p-6 hidden sm:block">
      <div class="flex justify-between mb-4"><div class="skeleton h-12 w-12 rounded-xl"></div><div class="skeleton h-6 w-16 rounded-full"></div></div>
      <div class="skeleton h-5 w-1/2 mb-2"></div><div class="skeleton h-4 w-full mb-4"></div>
      <div class="skeleton h-8 w-20 mt-4"></div>
    </div>
  </div>

  <!-- Empty state -->
  <div id="emptyState" class="hidden text-center py-20">
    <svg class="w-16 h-16 mx-auto mb-4 text-zinc-300 dark:text-zinc-600" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/></svg>
    <h3 class="text-lg font-semibold mb-1">Sin resultados</h3>
    <p class="text-sm text-zinc-500 dark:text-zinc-400">Intenta con otro término de búsqueda</p>
  </div>

  <!-- Products grid -->
  <div id="productsGrid" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>

  <!-- Pagination -->
  <div id="pagination" class="hidden flex items-center justify-center gap-4 mt-8">
    <button id="prevBtn" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-zinc-200 dark:border-zinc-700 text-sm font-medium hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors disabled:opacity-30 disabled:cursor-not-allowed">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
      Anterior
    </button>
    <span id="pageInfo" class="text-sm text-zinc-500 dark:text-zinc-400"></span>
    <button id="nextBtn" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl border border-zinc-200 dark:border-zinc-700 text-sm font-medium hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors disabled:opacity-30 disabled:cursor-not-allowed">
      Siguiente
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
    </button>
  </div>

</DashboardLayout>

<!-- Product Modal -->
<div id="productModal" class="fixed inset-0 z-[100] hidden">
  <div class="fixed inset-0 bg-black/20 dark:bg-black/50 backdrop-blur-sm" id="modalBackdrop"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4">
    <div class="relative bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-700 shadow-2xl w-full max-w-md p-6" id="modalBox">
      <div class="flex justify-between items-center mb-6">
        <h3 id="modalTitle" class="text-lg font-semibold tracking-tight">Nuevo Producto</h3>
        <button id="closeModal" class="p-1.5 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-400 hover:text-zinc-600 dark:hover:text-zinc-300 transition-colors" aria-label="Cerrar">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <form id="productForm" class="space-y-4">
        <input type="hidden" id="productId" />
        <div class="grid grid-cols-2 gap-4">
          <div class="col-span-2">
            <label for="pName" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Nombre</label>
            <input id="pName" class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-sm outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition-all" placeholder="Nombre del producto" required />
          </div>
          <div>
            <label for="pPrice" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Precio</label>
            <input id="pPrice" type="number" step="0.01" min="0" class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-sm outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition-all" placeholder="0.00" required />
          </div>
          <div>
            <label for="pStock" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Stock</label>
            <input id="pStock" type="number" min="0" class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-sm outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition-all" placeholder="0" />
          </div>
          <div>
            <label for="pCategory" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Categoría</label>
            <input id="pCategory" class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-sm outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition-all" placeholder="Categoría..." list="categoriasList" />
            <datalist id="categoriasList"></datalist>
          </div>
          <div>
            <label for="pBrand" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Marca</label>
            <input id="pBrand" class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-sm outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition-all" placeholder="Marca..." list="marcasList" />
            <datalist id="marcasList"></datalist>
          </div>
          <div class="col-span-2">
            <label for="pDesc" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-1.5">Descripción</label>
            <textarea id="pDesc" class="w-full px-3.5 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-sm outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition-all resize-none" rows="2" placeholder="Descripción del producto..."></textarea>
          </div>
        </div>
        <div id="modalError" class="hidden px-4 py-3 rounded-xl bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-rose-700 dark:text-rose-400 text-sm"></div>
        <div class="flex gap-3 pt-2">
          <button type="button" id="cancelModal" class="flex-1 py-2.5 rounded-xl border border-zinc-200 dark:border-zinc-700 text-sm font-medium hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">Cancelar</button>
          <button type="submit" id="saveBtn" class="flex-1 py-2.5 rounded-xl bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700 transition-colors disabled:opacity-50"><span id="saveBtnText">Guardar</span></button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  import api from '../lib/api.js';
  import { isAuthenticated, isAdmin } from '../lib/auth.js';

  let currentPage = 0;
  const limit = 9;
  let currentSearch = '';
  let currentSort = 'created_at';
  let editingId: number | null = null;

  // XSS-safe text helper
  function esc(str: string) {
    const d = document.createElement('div');
    d.textContent = str;
    return d.innerHTML;
  }

  // Load categories/brands
  async function cargarCategoriasMarcas() {
    try {
      const categorias = await api.getCategories();
      const marcas = await api.getBrands();
      document.getElementById('categoriasList')!.innerHTML = categorias.map((cat: string) => `<option value="${esc(cat)}">`).join('');
      document.getElementById('marcasList')!.innerHTML = marcas.map((m: string) => `<option value="${esc(m)}">`).join('');
    } catch (err) {
      console.error('Error cargando categorías/marcas:', err);
    }
  }

  // Auth UI
  const authenticated = isAuthenticated();
  const admin = isAdmin();

  if (authenticated) {
    if (admin) {
      document.getElementById('adminActions').style.display = '';
    }
  } else {
    document.getElementById('loginLink').style.display = '';
  }

  // Load products
  async function loadProducts(skip = 0, search = '', sort = 'created_at') {
    const loadingEl = document.getElementById('loadingState');
    const gridEl = document.getElementById('productsGrid');
    const emptyEl = document.getElementById('emptyState');
    const paginEl = document.getElementById('pagination');

    loadingEl.classList.remove('hidden');
    gridEl.classList.add('hidden');
    emptyEl.classList.add('hidden');
    paginEl.classList.add('hidden');

    const sortMap = {
      price_asc: { sort_by: 'price', order: 'asc' },
      price_desc: { sort_by: 'price', order: 'desc' },
      name: { sort_by: 'name', order: 'asc' },
      created_at: { sort_by: 'created_at', order: 'desc' }
    };
    const sortParams = (sortMap as Record<string, any>)[sort] || {};

    try {
      const data = await api.getProducts({ skip, limit, search, ...sortParams });
      loadingEl.classList.add('hidden');

      if (data.products.length === 0) {
        emptyEl.classList.remove('hidden');
        return;
      }

      gridEl.innerHTML = data.products.map((p: any) => `
        <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 p-6 hover:border-zinc-300 dark:hover:border-zinc-700 hover:shadow-md transition-all duration-200 group">
          <div class="flex justify-between items-start mb-4">
            <div class="w-11 h-11 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 flex items-center justify-center">
              <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/></svg>
            </div>
            <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium ${p.stock > 0
              ? 'bg-emerald-50 dark:bg-emerald-500/10 text-emerald-700 dark:text-emerald-400'
              : 'bg-rose-50 dark:bg-rose-500/10 text-rose-700 dark:text-rose-400'}">
              ${p.stock > 0 ? esc(String(p.stock)) + ' uds' : 'Agotado'}
            </span>
          </div>
          <h3 class="font-semibold text-base mb-1 leading-tight">${esc(p.name)}</h3>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 mb-4 line-clamp-2">${esc(p.description || 'Sin descripción')}</p>
          <div class="flex justify-between items-end pt-4 border-t border-zinc-100 dark:border-zinc-800">
            <div>
              <p class="text-xl font-bold text-indigo-600 dark:text-indigo-400">$${esc(String(p.price))}</p>
              <p class="text-xs text-zinc-400 dark:text-zinc-500 mt-0.5">${esc(p.category || '')}</p>
            </div>
            ${admin ? `
              <div class="flex gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
                <button onclick="editProduct(${p.id},'${esc(p.name).replace(/'/g, "\\'")}',${p.price},${p.stock},'${esc(p.category||'').replace(/'/g, "\\'")}','${esc(p.brand||'').replace(/'/g, "\\'")}','${esc(p.description||'').replace(/'/g, "\\'")}')"
                  class="p-2 rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-400 hover:text-zinc-700 dark:hover:text-zinc-300 transition-all" title="Editar">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/></svg>
                </button>
                <button onclick="deleteProduct(${p.id},'${esc(p.name).replace(/'/g, "\\'")}')"
                  class="p-2 rounded-lg hover:bg-rose-50 dark:hover:bg-rose-500/10 text-zinc-400 hover:text-rose-600 dark:hover:text-rose-400 transition-all" title="Eliminar">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
                </button>
              </div>` : ''}
          </div>
        </div>
      `).join('');

      gridEl.classList.remove('hidden');

      // Pagination
      const total = data.total;
      document.getElementById('pageInfo').textContent = `${skip + 1}–${Math.min(skip + limit, total)} de ${total}`;
      (document.getElementById('prevBtn') as HTMLButtonElement).disabled = skip === 0;
      (document.getElementById('nextBtn') as HTMLButtonElement).disabled = skip + limit >= total;
      paginEl.classList.remove('hidden');
    } catch (err: any) {
      loadingEl.innerHTML = `
        <div class="col-span-full text-center py-12">
          <p class="text-rose-600 dark:text-rose-400 font-medium mb-4">Error: ${esc(err.message)}</p>
          <button onclick="loadProducts()" class="px-4 py-2 rounded-xl border border-zinc-200 dark:border-zinc-700 text-sm font-medium hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">Reintentar</button>
        </div>`;
    }
  }

  // Search
  document.getElementById('searchBtn')?.addEventListener('click', () => {
    currentSearch = (document.getElementById('searchInput') as HTMLInputElement).value.trim();
    currentPage = 0;
    currentSort = (document.getElementById('sortSelect') as HTMLSelectElement).value;
    loadProducts(0, currentSearch, currentSort);
  });
  document.getElementById('searchInput')?.addEventListener('keydown', e => {
    if (e.key === 'Enter') document.getElementById('searchBtn').click();
  });
  document.getElementById('sortSelect')?.addEventListener('change', () => {
    document.getElementById('searchBtn').click();
  });

  // Pagination
  document.getElementById('prevBtn')?.addEventListener('click', () => {
    if (currentPage > 0) { currentPage--; loadProducts(currentPage * limit, currentSearch, currentSort); }
  });
  document.getElementById('nextBtn')?.addEventListener('click', () => {
    currentPage++;
    loadProducts(currentPage * limit, currentSearch, currentSort);
  });

  // Modal
  const modal = document.getElementById('productModal')!;
  const form = document.getElementById('productForm') as HTMLFormElement;

  function openModal(title = 'Nuevo Producto') {
    document.getElementById('modalTitle').textContent = title;
    document.getElementById('modalError').classList.add('hidden');
    cargarCategoriasMarcas();
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function closeModalFn() {
    modal.classList.add('hidden');
    document.body.style.overflow = '';
    form.reset();
    editingId = null;
  }

  document.getElementById('newProductBtn')?.addEventListener('click', () => {
    editingId = null;
    document.getElementById('saveBtnText').textContent = 'Crear producto';
    openModal('Nuevo Producto');
  });
  document.getElementById('closeModal')?.addEventListener('click', closeModalFn);
  document.getElementById('cancelModal')?.addEventListener('click', closeModalFn);
  document.getElementById('modalBackdrop')?.addEventListener('click', closeModalFn);

  // Edit product
  (window as any).editProduct = function(id: number, name: string, price: number, stock: number, category: string, brand: string, description: string) {
    editingId = id;
    (document.getElementById('pName') as HTMLInputElement).value = name;
    (document.getElementById('pPrice') as HTMLInputElement).value = String(price);
    (document.getElementById('pStock') as HTMLInputElement).value = String(stock);
    (document.getElementById('pCategory') as HTMLInputElement).value = category;
    (document.getElementById('pBrand') as HTMLInputElement).value = brand;
    (document.getElementById('pDesc') as HTMLTextAreaElement).value = description;
    document.getElementById('saveBtnText').textContent = 'Guardar cambios';
    openModal('Editar Producto');
  };

  // Delete product
  (window as any).deleteProduct = async function(id: number, name: string) {
    if (!confirm(`¿Eliminar "${name}"?`)) return;
    try {
      await api.deleteProduct(id);
      showToast(`"${name}" eliminado`, 'success');
      loadProducts(currentPage * limit, currentSearch, currentSort);
    } catch (err: any) {
      showToast(err.message, 'error');
    }
  };

  // Form submit
  form?.addEventListener('submit', async e => {
    e.preventDefault();
    const errEl = document.getElementById('modalError');
    errEl.classList.add('hidden');
    document.getElementById('saveBtnText')!.textContent = 'Guardando...';
    (document.getElementById('saveBtn') as HTMLButtonElement).disabled = true;

    const productData = {
      name: (document.getElementById('pName') as HTMLInputElement).value,
      price: parseFloat((document.getElementById('pPrice') as HTMLInputElement).value),
      stock: parseInt((document.getElementById('pStock') as HTMLInputElement).value) || 0,
      category: (document.getElementById('pCategory') as HTMLInputElement).value || null,
      brand: (document.getElementById('pBrand') as HTMLInputElement).value || null,
      description: (document.getElementById('pDesc') as HTMLTextAreaElement).value || null,
    };

    try {
      if (editingId) {
        await api.updateProduct(editingId, productData);
        showToast('Producto actualizado', 'success');
      } else {
        await api.createProduct(productData);
        showToast('Producto creado', 'success');
      }
      closeModalFn();
      loadProducts(currentPage * limit, currentSearch, currentSort);
    } catch (err: any) {
      errEl.textContent = err.message;
      errEl.classList.remove('hidden');
      document.getElementById('saveBtnText')!.textContent = editingId ? 'Guardar cambios' : 'Crear producto';
      (document.getElementById('saveBtn') as HTMLButtonElement).disabled = false;
    }
  });

  // Initial load
  loadProducts();
</script>

