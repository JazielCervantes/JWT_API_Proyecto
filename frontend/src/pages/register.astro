---
import Layout from '../layouts/Layout.astro';
import ThemeToggle from '../components/ui/ThemeToggle.vue';
---
<Layout title="Registro">
<div class="min-h-screen flex items-center justify-center px-6 py-16">
  <div class="w-full max-w-lg">

    <!-- Header -->
    <div class="text-center mb-10">
      <div class="flex justify-center mb-6">
        <a href="/" class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center">
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z"/>
            </svg>
          </div>
          <span class="font-semibold text-xl tracking-tight">API REST</span>
        </a>
      </div>
      <div class="flex justify-center mb-6">
        <ThemeToggle client:load />
      </div>
      <h1 class="text-2xl font-bold tracking-tight mb-2">Crear cuenta</h1>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        ¿Ya tienes cuenta? <a href="/login" class="text-indigo-600 dark:text-indigo-400 hover:underline font-medium">Inicia sesión</a>
      </p>
    </div>

    <!-- Form Card -->
    <div class="bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 p-8">
      <form id="registerForm" class="space-y-5">

        <!-- Full name -->
        <div>
          <label for="full_name" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">Nombre Completo</label>
          <input id="full_name" name="full_name" type="text" required
            class="w-full px-4 py-3 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 text-sm placeholder-zinc-400 dark:placeholder-zinc-500 outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition-all duration-200"
            placeholder="Juan Pérez" autocomplete="name"/>
        </div>

        <!-- Email & Username grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="reg_email" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">Email</label>
            <input id="reg_email" name="email" type="email" required
              class="w-full px-4 py-3 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 text-sm placeholder-zinc-400 dark:placeholder-zinc-500 outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition-all duration-200"
              placeholder="juan@email.com" autocomplete="email"/>
          </div>
          <div>
            <label for="reg_username" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">Usuario</label>
            <input id="reg_username" name="username" type="text" required minlength="3"
              class="w-full px-4 py-3 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 text-sm placeholder-zinc-400 dark:placeholder-zinc-500 outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition-all duration-200"
              placeholder="juanperez" autocomplete="username"/>
          </div>
        </div>

        <!-- Password -->
        <div>
          <label for="passInput" class="block text-sm font-medium text-zinc-700 dark:text-zinc-300 mb-2">Contraseña</label>
          <input id="passInput" name="password" type="password" required minlength="8"
            class="w-full px-4 py-3 rounded-xl border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-zinc-100 text-sm placeholder-zinc-400 dark:placeholder-zinc-500 outline-none focus:ring-2 focus:ring-indigo-500/40 focus:border-indigo-500 transition-all duration-200"
            placeholder="Mín 8 chars: Mayúscula, minúscula, número y especial (@$!%*?&)"/>
          <!-- Indicador de fuerza -->
          <div class="mt-2.5 flex gap-1">
            <div id="s1" class="h-1 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-700 transition-all duration-300"></div>
            <div id="s2" class="h-1 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-700 transition-all duration-300"></div>
            <div id="s3" class="h-1 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-700 transition-all duration-300"></div>
            <div id="s4" class="h-1 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-700 transition-all duration-300"></div>
            <div id="s5" class="h-1 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-700 transition-all duration-300"></div>
          </div>
          <p id="strengthLabel" class="text-xs mt-1.5 text-zinc-400 dark:text-zinc-500"></p>
        </div>

        <!-- Alerts -->
        <div id="errorAlert" class="hidden px-4 py-3 rounded-xl bg-rose-50 dark:bg-rose-500/10 border border-rose-200 dark:border-rose-500/20 text-rose-700 dark:text-rose-400 text-sm" role="alert"></div>
        <div id="successAlert" class="hidden px-4 py-3 rounded-xl bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-700 dark:text-emerald-400 text-sm" role="status"></div>

        <button type="submit" id="submitBtn"
          class="w-full py-3 rounded-xl text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed transition-all duration-200 shadow-sm shadow-indigo-600/20 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 focus:ring-offset-2 focus:ring-offset-white dark:focus:ring-offset-zinc-950">
          <span id="btnText">Crear cuenta</span>
        </button>

        <p class="text-center text-xs text-zinc-400 dark:text-zinc-500">
          Al registrarte aceptas los términos de uso.
        </p>
      </form>
    </div>
  </div>
</div>
</Layout>

<script>
  import api from '../lib/api.js';
  import { saveUser } from '../lib/auth.js';

  const form = document.getElementById('registerForm') as HTMLFormElement;
  const errorAlert = document.getElementById('errorAlert')!;
  const successAlert = document.getElementById('successAlert')!;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const btnText = document.getElementById('btnText')!;
  const passInput = document.getElementById('passInput') as HTMLInputElement;

  // Password strength
  passInput?.addEventListener('input', () => {
    const val = passInput.value;
    const scores = [val.length >= 8, /[a-z]/.test(val), /[A-Z]/.test(val), /[0-9]/.test(val), /[@$!%*?&]/.test(val)];
    const count = scores.filter(Boolean).length;
    const colors = ['#f43f5e', '#f43f5e', '#f59e0b', '#eab308', '#10b981'];
    const labels = ['Muy débil', 'Débil', 'Regular', 'Buena', 'Fuerte'];
    const stripes = ['s1', 's2', 's3', 's4', 's5'];

    stripes.forEach((id, i) => {
      const el = document.getElementById(id);
      el.style.background = i < count ? colors[count - 1] : '';
      if (i >= count) el.className = 'h-1 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-700 transition-all duration-300';
      else el.className = 'h-1 flex-1 rounded-full transition-all duration-300';
    });
    const label = document.getElementById('strengthLabel');
    label.textContent = val.length > 0 ? labels[count - 1] || '' : '';
    label.style.color = count > 0 ? colors[count - 1] : '';
  });

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    btnText.textContent = loading ? 'Creando cuenta...' : 'Crear cuenta';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorAlert.classList.add('hidden');
    successAlert.classList.add('hidden');
    setLoading(true);

    const fd = new FormData(form);
    const userData = {
      full_name: fd.get('full_name') as string,
      email: fd.get('email') as string,
      username: fd.get('username') as string,
      password: fd.get('password') as string,
    };

    // Validar contraseña antes de enviar
    const pass = userData.password;
    if (pass.length < 8 || !/[a-z]/.test(pass) || !/[A-Z]/.test(pass) || !/[0-9]/.test(pass) || !/[@$!%*?&]/.test(pass)) {
      errorAlert.textContent = 'La contraseña debe tener mínimo 8 caracteres, incluir mayúscula, minúscula, número y carácter especial (@$!%*?&)';
      errorAlert.classList.remove('hidden');
      setLoading(false);
      return;
    }

    try {
      await api.register(userData);
      // Auto-login: iniciar sesión automáticamente con las mismas credenciales
      await api.login(userData.username, userData.password);
      const user = await api.getCurrentUser();
      saveUser(user);
      successAlert.textContent = '✓ ¡Cuenta creada! Ingresando...';
      successAlert.classList.remove('hidden');
      showToast(`¡Bienvenido, ${user.full_name}!`, 'success');
      setTimeout(() => window.location.href = '/dashboard', 1200);
    } catch (err: any) {
      errorAlert.textContent = err.message || 'Error al crear la cuenta';
      errorAlert.classList.remove('hidden');
      setLoading(false);
    }
  });
</script>
